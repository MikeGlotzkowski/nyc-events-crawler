{"jsonapi":{"version":"1.0","meta":{"links":{"self":{"href":"http://jsonapi.org/format/1.0/"}}}},"data":{"type":"node--event","id":"85b9c486-528c-42e0-9d9e-12e3511dea69","links":{"self":{"href":"https://drupal.nypl.org/jsonapi/node/event/85b9c486-528c-42e0-9d9e-12e3511dea69?resourceVersion=id%3A347651"},"working-copy":{"href":"https://drupal.nypl.org/jsonapi/node/event/85b9c486-528c-42e0-9d9e-12e3511dea69?resourceVersion=rel%3Aworking-copy"}},"attributes":{"title":"Sunday Family Storytime","path":{"alias":"/events/programs/2026/10/04/sunday-family-storytime","pid":215897,"langcode":"en"},"body":{"value":"<p><strong>&nbsp; &nbsp;This event will take place in person at Bronx Library Center</strong>.</p>\n\n<p>&nbsp; &nbsp; &nbsp;Join us for songs, rhymes, and favorite read-aloud books as we show you that storytime is fun for the whole family. For young children of all ages. Ideal for caregivers with multiple-aged children.&nbsp;</p>\n\n<h4>______________________________________________________________________________________________________<em><strong>&nbsp; &nbsp; &nbsp;Este evento se llevará a cabo en persona en la Biblioteca Central del Bronx.</strong></em></h4>\n\n<h4><em>&nbsp; &nbsp; &nbsp; Únase a nosotros para escuchar canciones, rimas y libros favoritos para leer en voz alta mientras le mostramos que la hora del cuento es divertida para toda la familia. Para niños pequeños de todas las edades. Ideal para cuidadores de niños de varias edades.</em></h4>","format":"text_with_video","processed":"<p><strong>&nbsp; &nbsp;This event will take place in person at Bronx Library Center</strong>.</p>\n<p>&nbsp; &nbsp; &nbsp;Join us for songs, rhymes, and favorite read-aloud books as we show you that storytime is fun for the whole family. For young children of all ages. Ideal for caregivers with multiple-aged children.&nbsp;</p>\n<h4>______________________________________________________________________________________________________<em><strong>&nbsp; &nbsp; &nbsp;Este evento se llevará a cabo en persona en la Biblioteca Central del Bronx.</strong></em></h4>\n<h4><em>&nbsp; &nbsp; &nbsp; Únase a nosotros para escuchar canciones, rimas y libros favoritos para leer en voz alta mientras le mostramos que la hora del cuento es divertida para toda la familia. Para niños pequeños de todas las edades. Ideal para cuidadores de niños de varias edades.</em></h4>\n","summary":null},"field_lt_event_format":"in_person","field_tfls_summary_description":{"value":"This event will take place in person at Bronx Library Center. Join us for songs, rhymes, and favorite read-aloud books as we show you that storytime is fun for the whole family.","format":"plain_text","processed":"<p>This event will take place in person at Bronx Library Center. Join us for songs, rhymes, and favorite read-aloud books as we show you that storytime is fun for the whole family.</p>\n"},"field_ts_event_leader_name":null},"relationships":{"field_erm_event_location":{"data":[{"type":"paragraph--event_location","id":"a964617a-7229-4b66-b2a2-8b694c725594","meta":{"target_revision_id":1379962,"drupal_internal__target_id":309163}}],"links":{"related":{"href":"https://drupal.nypl.org/jsonapi/node/event/85b9c486-528c-42e0-9d9e-12e3511dea69/field_erm_event_location?resourceVersion=id%3A347651"},"self":{"href":"https://drupal.nypl.org/jsonapi/node/event/85b9c486-528c-42e0-9d9e-12e3511dea69/relationships/field_erm_event_location?resourceVersion=id%3A347651"}}},"field_erm_event_type":{"data":{"type":"taxonomy_term--event_type","id":"2711d713-4fc1-42b8-a763-31d795f28266","meta":{"drupal_internal__target_id":458}},"links":{"related":{"href":"https://drupal.nypl.org/jsonapi/node/event/85b9c486-528c-42e0-9d9e-12e3511dea69/field_erm_event_type?resourceVersion=id%3A347651"},"self":{"href":"https://drupal.nypl.org/jsonapi/node/event/85b9c486-528c-42e0-9d9e-12e3511dea69/relationships/field_erm_event_type?resourceVersion=id%3A347651"}}},"field_ers_media_image":{"data":null,"links":{"related":{"hr