{"jsonapi":{"version":"1.0","meta":{"links":{"self":{"href":"http://jsonapi.org/format/1.0/"}}}},"data":{"type":"node--event","id":"9ea44e65-91f9-4548-8414-281bca3a5790","links":{"self":{"href":"https://drupal.nypl.org/jsonapi/node/event/9ea44e65-91f9-4548-8414-281bca3a5790?resourceVersion=id%3A394305"},"working-copy":{"href":"https://drupal.nypl.org/jsonapi/node/event/9ea44e65-91f9-4548-8414-281bca3a5790?resourceVersion=rel%3Aworking-copy"}},"attributes":{"title":"Open Studio Sessions at the Teen Center","path":{"alias":"/events/programs/2026/09/07/open-studio-sessions-teen-center","pid":227824,"langcode":"en"},"body":{"value":"<h3><strong>Are you a budding musician looking to record your next hit song? Our state-of-the-art recording studio is here to help!</strong></h3><p>&nbsp;</p><p>Open Studio offers a unique opportunity for teens to come in, record their music, and receive feedback from their peers and an engineer. Plus, you'll have the chance to learn about audio engineering and get a behind-the-scenes look at the recording process.</p><p>In Open Studio teens are invited to record 1 song up to 3 minutes. &nbsp;<br>Depending on registrants for the day, sessions can be capped at 20 minutes.<br>Bring your own instrument, or we can provide a guitar or bass</p><p>If you’re ready to sign up, you can register for the program in-person at the Teen Center circulation desk on the Lower Level of the Stavros Niarchos Foundation Library, or by phone at 212-340-0925. &nbsp;If the program is full, we will create an in-person waitlist day-of. &nbsp;</p>","format":"text_with_video","processed":"<h3><strong>Are you a budding musician looking to record your next hit song? Our state-of-the-art recording studio is here to help!</strong></h3>\n<p class=\"clear-both\">&nbsp;</p>\n<p>Open Studio offers a unique opportunity for teens to come in, record their music, and receive feedback from their peers and an engineer. Plus, you'll have the chance to learn about audio engineering and get a behind-the-scenes look at the recording process.</p>\n<p>In Open Studio teens are invited to record 1 song up to 3 minutes. &nbsp;<br>Depending on registrants for the day, sessions can be capped at 20 minutes.<br>Bring your own instrument, or we can provide a guitar or bass</p>\n<p>If you’re ready to sign up, you can register for the program in-person at the Teen Center circulation desk on the Lower Level of the Stavros Niarchos Foundation Library, or by phone at 212-340-0925. &nbsp;If the program is full, we will create an in-person waitlist day-of. &nbsp;</p>\n","summary":""},"field_lt_event_format":"in_person","field_tfls_summary_description":{"value":"This program is made possible by the Stavros Niarchos Foundation (SNF).","format":null,"processed":"<p>This program is made possible by the Stavros Niarchos Foundation (SNF).</p>\n"},"field_ts_event_leader_name":null},"relationships":{"field_erm_event_location":{"data":[{"type":"paragraph--event_location","id":"d37460bd-7ca6-4b71-aa6a-c6d681b7189c","meta":{"target_revision_id":1436668,"drupal_internal__target_id":317289}},{"type":"paragraph--event_location","id":"381e492d-b6c4-4b6e-94cc-1a93767ea591","meta":{"target_revision_id":1436669,"drupal_internal__target_id":317290}}],"links":{"related":{"href":"https://drupal.nypl.org/jsonapi/node/event/9ea44e65-91f9-4548-8414-281bca3a5790/field_erm_event_location?resourceVersion=id%3A394305"},"self":{"href":"https://drupal.nypl.org/jsonapi/node/event/9ea44e65-91f9-4548-8414-281bca3a5790/relationships/field_erm_event_location?resourceVersion=id%3A394305"}}},"field_erm_event_type":{"data":{"type":"taxonomy_term--event_type","id":"50aa5479-960d-4e6b-aeca-3eb89f764ecf","meta":{"drupal_internal__target_id":1468}},"links":{"related":{"href":"https://drupal.nypl.org/jsonapi/node/event/9ea44e65-91f9-4548-8414-281bca3a5790/field_erm_event_type?resourceVersion=id%3A394305"},"self":{"href":"https://drupal.nypl.org/jsonapi/node/event/9ea44e65-91f9-4548-8414-281bca3a5790/relatio