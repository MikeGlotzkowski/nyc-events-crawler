                    </script></div></div></div></div></div><article class="tile _article_a9slj_1" data-testid="tile-zone-large-list_testID"><div class="articleContent _articleContent_a9slj_226"><div class="_title_a9slj_11"><a href="/newyork/things-to-do/its-alive-a-century-of-animation-from-the-collection" class="" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;in content&quot;,&quot;action&quot;:&quot;link - internal&quot;}}" data-testid="tile-link_testID"><h3 class="_h3_c6c0h_1" data-testid="tile-title_testID"><span>27.</span>&nbsp;It’s Alive! A Century of Animation from the Collection</h3></a></div><div class="_tileTags_a9slj_52"><section class="_tags_1i2cm_17" data-testid="tags_testID"><ul class="_tagsList_1i2cm_17"><li class="_tag_1i2cm_17"><span class="_text_1i2cm_68">Things to do</span></li></ul></section></div><div class="_imageContainer_a9slj_48"><a href="/newyork/things-to-do/its-alive-a-century-of-animation-from-the-collection" class="tileImageLink" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;in content&quot;,&quot;action&quot;:&quot;link - internal&quot;}}" data-testid="tile-link_testID"><div class="_imageWrap_a9slj_96 _imageWrapDesktop_a9slj_100"><picture><source type="image/webp" srcSet="https://media.timeout.com/images/106431384/400/225/image.webp 400w,https://media.timeout.com/images/106431384/750/422/image.webp 750w,https://media.timeout.com/images/106431384/1024/576/image.webp 1024w,https://media.timeout.com/images/106431384/1372/772/image.webp 1372w,https://media.timeout.com/images/106431384/1536/864/image.webp 1536w,https://media.timeout.com/images/106431384/1920/1080/image.webp 1920w" width="750" height="422"/><img src="https://media.timeout.com/images/106431384/750/422/image.jpg" srcSet="https://media.timeout.com/images/106431384/400/225/image.jpg 400w,https://media.timeout.com/images/106431384/750/422/image.jpg 750w,https://media.timeout.com/images/106431384/1024/576/image.jpg 1024w,https://media.timeout.com/images/106431384/1372/772/image.jpg 1372w,https://media.timeout.com/images/106431384/1536/864/image.jpg 1536w,https://media.timeout.com/images/106431384/1920/1080/image.jpg 1920w" sizes="auto" class="_image_a9slj_48 aspect-ratio-16-9" title="It’s Alive! A Century of Animation from the Collection" alt="It’s Alive! A Century of Animation from the Collection" width="750" height="422" data-testid="responsive-image_testID" loading="lazy"/></picture></div><div class="_imageWrap_a9slj_96 _imageWrapMobile_a9slj_205"><picture><source type="image/webp" srcSet="https://media.timeout.com/images/106431384/380/285/image.webp 380w,https://media.timeout.com/images/106431384/750/562/image.webp 750w,https://media.timeout.com/images/106431384/1024/768/image.webp 1024w,https://media.timeout.com/images/106431384/1372/1029/image.webp 1372w,https://media.timeout.com/images/106431384/1536/1152/image.webp 1536w,https://media.timeout.com/images/106431384/1920/1440/image.webp 1920w" width="750" height="562"/><img src="https://media.timeout.com/images/106431384/750/562/image.jpg" srcSet="https://media.timeout.com/images/106431384/380/285/image.jpg 380w,https://media.timeout.com/images/106431384/750/562/image.jpg 750w,https://media.timeout.com/images/106431384/1024/768/image.jpg 1024w,https://media.timeout.com/images/106431384/1372/1029/image.jpg 1372w,https://media.timeout.com/images/106431384/1536/1152/image.jpg 1536w,https://media.timeout.com/images/106431384/1920/1440/image.jpg 1920w" sizes="auto" class="_image_a9slj_48 aspect-ratio-4-3" title="It’s Alive! A Century of Animation from the Collection" alt="It’s Alive! A Century of Animation from the Collection" width="750" height="562" data-testid="responsive-image_testID" loading="lazy"/></picture></div><figcaption class="_figcaption_18vpl_1" data-testid="image-credits_testID"><span>Photograph: Courtesy MoMA</span></figcaption></a></div><div class="_summaryContainer_a9slj_361"><div class="_summary_a9slj_23"><div class="_p_1mmxl_1" data-testid="summary_testID"><p>Animation&nbsp;existed&nbsp;in movies long before Walt Disney&nbsp;and Mickey Mouse.&nbsp;This summer, MoMA is celebrating the whole wonderfully weird history with <em>It&rsquo;s Alive!,</em>&nbsp;an exhibit that brings together more than 200 works spanning 1908 to 2020, from Gertie the Dinosaur to experimental artists, <em>Sesame Street</em>&nbsp;and those gloriously bizarre MTV-era music spots. With more than 35 artists represented,&nbsp;the exhibit also features a special focus on the genre's NYC roots.&nbsp;</p></div></div></div><div class="_ctaButtons_a9slj_109"><div class="_cta_a9slj_109 _viewMoreCta_a9slj_130"><a class="_secondary_1gagn_22" href="/newyork/things-to-do/its-alive-a-century-of-animation-from-the-collection" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;action&quot;:&quot;link - internal&quot;,&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;read more button&quot;}}" data-testid="view-more-cta_testID"><span class="_textContent_1gagn_69">Read more</span></a></div></div></div></article><article class="tile _article_a9slj_1" data-testid="tile-zone-large-list_testID"><div class="articleContent _articleContent_a9slj_226"><div class="_title_a9slj_11"><a href="/newyork/things-to-do/reframing-the-slasher-teenage-sex-and-death-at-camp-miasma" class="" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;in content&quot;,&quot;action&quot;:&quot;link - internal&quot;}}" data-testid="tile-link_testID"><h3 class="_h3_c6c0h_1" data-testid="tile-title_testID"><span>28.</span>&nbsp;Reframing the Slasher: Teenage Sex and Death at Camp Miasma</h3></a></div><div class="_tileTags_a9slj_52"><section class="_tags_1i2cm_17" data-testid="tags_testID"><ul class="_tagsList_1i2cm_17"><li class="_tag_1i2cm_17"><span class="_text_1i2cm_68">Things to do</span></li></ul></section></div><div class="_imageContainer_a9slj_48"><a href="/newyork/things-to-do/reframing-the-slasher-teenage-sex-and-death-at-camp-miasma" class="tileImageLink" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;in content&quot;,&quot;action&quot;:&quot;link - internal&quot;}}" data-testid="tile-link_testID"><div class="_imageWrap_a9slj_96 _imageWrapDesktop_a9slj_100"><picture><source type="image/webp" srcSet="https://media.timeout.com/images/106428229/400/225/image.webp 400w,https://media.timeout.com/images/106428229/750/422/image.webp 750w,https://media.timeout.com/images/106428229/1024/576/image.webp 1024w,https://media.timeout.com/images/106428229/1372/772/image.webp 1372w,https://media.timeout.com/images/106428229/1536/864/image.webp 1536w,https://media.timeout.com/images/106428229/1920/1080/image.webp 1920w" width="750" height="422"/><img src="https://media.timeout.com/images/106428229/750/422/image.jpg" srcSet="https://media.timeout.com/images/106428229/400/225/image.jpg 400w,https://media.timeout.com/images/106428229/750/422/image.jpg 750w,https://media.timeout.com/images/106428229/1024/576/image.jpg 1024w,https://media.timeout.com/images/106428229/1372/772/image.jpg 1372w,https://media.timeout.com/images/106428229/1536/864/image.jpg 1536w,https://media.timeout.com/images/106428229/1920/1080/image.jpg 1920w" sizes="auto" class="_image_a9slj_48 aspect-ratio-16-9" title="Reframing the Slasher: Teenage Sex and Death at Camp Miasma" alt="Reframing the Slasher: Teenage Sex and Death at Camp Miasma" width="750" height="422" data-testid="responsive-image_testID" loading="lazy"/></picture></div><div class="_imageWrap_a9slj_96 _imageWrapMobile_a9slj_205"><picture><source type="image/webp" srcSet="https://media.timeout.com/images/106428229/380/285/image.webp 380w,https://media.timeout.com/images/106428229/750/562/image.webp 750w,https://media.timeout.com/images/106428229/1024/768/image.webp 1024w,https://media.timeout.com/images/106428229/1372/1029/image.webp 1372w,https://media.timeout.com/images/106428229/1536/1152/image.webp 1536w,https://media.timeout.com/images/106428229/1920/1440/image.webp 1920w" width="750" height="562"/><img src="https://media.timeout.com/images/106428229/750/562/image.jpg" srcSet="https://media.timeout.com/images/106428229/380/285/image.jpg 380w,https://media.timeout.com/images/106428229/750/562/image.jpg 750w,https://media.timeout.com/images/106428229/1024/768/image.jpg 1024w,https://media.timeout.com/images/106428229/1372/1029/image.jpg 1372w,https://media.timeout.com/images/106428229/1536/1152/image.jpg 1536w,https://media.timeout.com/images/106428229/1920/1440/image.jpg 1920w" sizes="auto" class="_image_a9slj_48 aspect-ratio-4-3" title="Reframing the Slasher: Teenage Sex and Death at Camp Miasma" alt="Reframing the Slasher: Teenage Sex and Death at Camp Miasma" width="750" height="562" data-testid="responsive-image_testID" loading="lazy"/></picture></div><figcaption class="_figcaption_18vpl_1" data-testid="image-credits_testID"><span>Photograph: Courtesy MUBI</span></figcaption></a></div><div class="_summaryContainer_a9slj_361"><div class="_summary_a9slj_23"><div class="_p_1mmxl_1" data-testid="summary_testID"><p>Before <em>Teenage Sex and Death at Camp Miasma</em> hits theaters August 7, the Museum of the Moving Image is inviting horror fans to check into its fictional summer camp.&nbsp;Opened July 30, Reframing the Slasher pairs props from Jane Schoenbrun&rsquo;s meta slasher&mdash;including VHS tapes, posters and costumes&mdash;with classic films that shaped the genre, from <em>Psycho</em> to <em>Sleepaway Camp</em>. It&rsquo;s a free exhibition for anyone who likes their nostalgia bloody, complicated and displayed behind glass.</p></div></div></div><div class="_ctaButtons_a9slj_109"><div class="_cta_a9slj_109 _viewMoreCta_a9slj_130"><a class="_secondary_1gagn_22" href="/newyork/things-to-do/reframing-the-slasher-teenage-sex-and-death-at-camp-miasma" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;action&quot;:&quot;link - internal&quot;,&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;read more button&quot;}}" data-testid="view-more-cta_testID"><span class="_textContent_1gagn_69">Read more</span></a></div></div></div></article><div class="_adsInline_1t43t_10"><div data-testid="inline-generated-ad_testID" class="_inlineAdWrapper_16tbe_72 containerAdWrapper"><div class="_inlineAdContainer_16tbe_67"><span class="caps xs-block xs-text-10 xs-mb2 xs-text-center _inlineAdHeader_16tbe_82">Advertising</span><div class="_inlineAd_16tbe_67"><div id="ad-list-14-9081" class="_ad_16tbe_1 containerAd _ad-list_16tbe_61 " data-testid="ad_testID"><script>
