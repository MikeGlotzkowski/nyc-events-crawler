" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;in content&quot;,&quot;action&quot;:&quot;link - internal&quot;}}" data-testid="tile-link_testID"><div class="_imageWrap_a9slj_96 _imageWrapDesktop_a9slj_100"><picture><source type="image/webp" srcSet="https://media.timeout.com/images/106441334/400/225/image.webp 400w,https://media.timeout.com/images/106441334/750/422/image.webp 750w,https://media.timeout.com/images/106441334/1024/576/image.webp 1024w,https://media.timeout.com/images/106441334/1372/772/image.webp 1372w,https://media.timeout.com/images/106441334/1536/864/image.webp 1536w,https://media.timeout.com/images/106441334/1920/1080/image.webp 1920w" width="750" height="422"/><img src="https://media.timeout.com/images/106441334/750/422/image.jpg" srcSet="https://media.timeout.com/images/106441334/400/225/image.jpg 400w,https://media.timeout.com/images/106441334/750/422/image.jpg 750w,https://media.timeout.com/images/106441334/1024/576/image.jpg 1024w,https://media.timeout.com/images/106441334/1372/772/image.jpg 1372w,https://media.timeout.com/images/106441334/1536/864/image.jpg 1536w,https://media.timeout.com/images/106441334/1920/1080/image.jpg 1920w" sizes="auto" class="_image_a9slj_48 aspect-ratio-16-9" title="Heart of the Beast" alt="Heart of the Beast" width="750" height="422" data-testid="responsive-image_testID" loading="lazy"/></picture></div><div class="_imageWrap_a9slj_96 _imageWrapMobile_a9slj_205"><picture><source type="image/webp" srcSet="https://media.timeout.com/images/106441334/380/285/image.webp 380w,https://media.timeout.com/images/106441334/750/562/image.webp 750w,https://media.timeout.com/images/106441334/1024/768/image.webp 1024w,https://media.timeout.com/images/106441334/1372/1029/image.webp 1372w,https://media.timeout.com/images/106441334/1536/1152/image.webp 1536w,https://media.timeout.com/images/106441334/1920/1440/image.webp 1920w" width="750" height="562"/><img src="https://media.timeout.com/images/106441334/750/562/image.jpg" srcSet="https://media.timeout.com/images/106441334/380/285/image.jpg 380w,https://media.timeout.com/images/106441334/750/562/image.jpg 750w,https://media.timeout.com/images/106441334/1024/768/image.jpg 1024w,https://media.timeout.com/images/106441334/1372/1029/image.jpg 1372w,https://media.timeout.com/images/106441334/1536/1152/image.jpg 1536w,https://media.timeout.com/images/106441334/1920/1440/image.jpg 1920w" sizes="auto" class="_image_a9slj_48 aspect-ratio-4-3" title="Heart of the Beast" alt="Heart of the Beast" width="750" height="562" data-testid="responsive-image_testID" loading="lazy"/></picture></div><figcaption class="_figcaption_18vpl_1" data-testid="image-credits_testID"><span>Photograph: Paramount Pictures</span></figcaption></a></div><div class="_summaryContainer_a9slj_361"><div class="_summary_a9slj_23"><div class="_p_1mmxl_1" data-testid="summary_testID"><p><em><span style="font-weight: 400;">Heart of the Beast&nbsp;</span></em><span style="font-weight: 400;">features&nbsp;</span><span style="font-weight: 400;">Brad Pitt&nbsp;as&nbsp;James Belmont, a bruised-hearted Green Beret, and&nbsp;</span><span style="font-weight: 400;">JK Simmons as Watkins, a camouflaged kayaker. And then there's the dog.&nbsp;</span><span style="font-weight: 400;">The story is of&nbsp;an endurance-testing survival trial full of nature&rsquo;s wildest pitfalls&mdash;often quite literally&mdash;replete with ornery stags, wolves and bears. (As ever, the animal CGI isn&rsquo;t all that convincing.)&nbsp;</span><span style="font-weight: 400;">Happily, </span><em><span style="font-weight: 400;">Heart of the Beast</span></em><span style="font-weight: 400;"> is mostly a gentle, emotional film.</span></p>
<p><em><span style="font-weight: 400;">In cinemas worldwide Friday, September 25.</span></em></p></div></div></div><div class="_ctaButtons_a9slj_109"><div class="_cta_a9slj_109 _viewMoreCta_a9slj_130"><a class="_secondary_1gagn_22" href="/movies/heart-of-the-beast-review-2026" target="_self" rel="" data-data-layer="{&quot;triggerOn&quot;:0,&quot;payload&quot;:{&quot;action&quot;:&quot;link - internal&quot;,&quot;category&quot;:&quot;GP Engagement&quot;,&quot;label&quot;:&quot;read more button&quot;}}" data-testid="view-more-cta_testID"><span class="_textContent_1gagn_69">Read review</span></a></div></div></div></article><div class="_adsInline_1t43t_10"><div data-testid="inline-generated-ad_testID" class="_inlineAdWrapper_16tbe_72 containerAdWrapper"><div class="_inlineAdContainer_16tbe_67"><span class="caps xs-block xs-text-10 xs-mb2 xs-text-center _inlineAdHeader_16tbe_82">Advertising</span><div class="_inlineAd_16tbe_67"><div id="ad-list-11-4780" class="_ad_16tbe_1 containerAd _ad-list_16tbe_61 " data-testid="ad_testID"><script>
