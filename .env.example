# Supabase (required for all crawlers)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI (required for rss-blogs LLM extraction and nyccom enrichment)
# NOTE: program items 02–04 migrate this to OpenRouter (OPENROUTER_API_KEY).
OPENAI_API_KEY=sk-...

# NYC.com crawler options
USE_LLM_EXTRACTION=false

# Vibe-tag enrichment — applies to ALL crawlers before upsert (one gpt-4o-mini call per new event)
# Cost: ~$0.000003/event. Leave unset or set to 'false' to skip enrichment entirely.
ENABLE_ENRICHMENT=true

# Test mode — limits nyccom crawler to 10 events
TEST_MODE=false

# Storage Mode — 'local' (default) or 's3'
# S3 is optional/legacy; Supabase is the primary store
STORAGE_MODE=local

# AWS S3 Configuration (optional — only needed when STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
